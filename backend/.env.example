# Server Configuration
PORT=5000

# MongoDB Connection String (e.g. mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/stockwise?retryWrites=true&w=majority)
MONGO_URI=

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Origins for CORS (comma-separated list)
CLIENT_URL=http://localhost:8080,http://127.0.0.1:8080
